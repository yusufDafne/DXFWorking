{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "daire-plani-ai/design.schema.json",
  "title": "Bina Plani Context Schema",
  "type": "object",
  "required": ["meta", "layers", "grid", "floors", "elevations", "rev_history"],
  "additionalProperties": false,
  "definitions": {
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }
    },
    "room": {
      "type": "object",
      "required": ["id", "name", "area_m2", "polygon"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "polygon": {
          "type": "array",
          "description": "Kapali poligonu tanimlayan koseler [[x,y], ...], en az 3 nokta",
          "minItems": 3,
          "items": { "$ref": "#/definitions/point" }
        },
        "layer": { "type": "string" }
      }
    },
    "wall": {
      "type": "object",
      "required": ["id", "start", "end", "thickness", "layer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "start": { "$ref": "#/definitions/point" },
        "end": { "$ref": "#/definitions/point" },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "layer": { "type": "string" }
      }
    },
    "opening": {
      "type": "object",
      "required": ["id", "type", "wall_id", "position_from_start", "width"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["door", "window"] },
        "wall_id": { "type": "string", "description": "Ait oldugu duvarin id degeri" },
        "position_from_start": {
          "type": "number",
          "minimum": 0,
          "description": "Duvarin baslangic noktasindan itibaren acikligin ortasina olan mesafe"
        },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "layer": { "type": "string" }
      }
    },
    "label": {
      "type": "object",
      "required": ["id", "type", "text", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "dimension"] },
        "text": { "type": "string" },
        "position": { "$ref": "#/definitions/point" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "layer": { "type": "string" }
      }
    },
    "counter": {
      "type": "object",
      "description": "Mutfak tezgahi gibi sabit mobilya elemanlari (dikdortgen poligon)",
      "required": ["id", "polygon", "layer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "room_id": { "type": "string" },
        "polygon": {
          "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/point" }
        },
        "layer": { "type": "string" }
      }
    },
    "marking": {
      "type": "object",
      "description": "Otopark cizgisi gibi salt gorsel/semantik olmayan isaretlemeler",
      "required": ["id", "start", "end", "layer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "start": { "$ref": "#/definitions/point" },
        "end": { "$ref": "#/definitions/point" },
        "layer": { "type": "string" }
      }
    },
    "floor": {
      "type": "object",
      "description": "Tek bir kat plani (pafta)",
      "required": ["id", "label", "rooms", "walls", "openings", "labels"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "description": "Pafta basligi / kat adi, orn. 'ZEMIN KAT'" },
        "sheet_note": { "type": "string", "description": "Pafta sag-alt kosesine yazilacak ek not" },
        "rooms": { "type": "array", "items": { "$ref": "#/definitions/room" } },
        "walls": { "type": "array", "items": { "$ref": "#/definitions/wall" } },
        "openings": { "type": "array", "items": { "$ref": "#/definitions/opening" } },
        "labels": { "type": "array", "items": { "$ref": "#/definitions/label" } },
        "counters": { "type": "array", "items": { "$ref": "#/definitions/counter" } },
        "markings": { "type": "array", "items": { "$ref": "#/definitions/marking" } }
      }
    },
    "elevation_level": {
      "type": "object",
      "required": ["label", "height"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "height": { "type": "number", "exclusiveMinimum": 0, "description": "Bu seviyenin kat yuksekligi" },
        "below_ground": { "type": "boolean", "description": "true ise zemin cizgisinin altinda (bodrum), kesikli cizilir" },
        "window_count": { "type": "integer", "minimum": 0 },
        "window_size": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" },
          "description": "[genislik, yukseklik]"
        },
        "door": { "type": "boolean", "description": "Bu seviyede zemin ortasinda bir giris kapisi cizilsin mi" },
        "machine_room": { "type": "boolean", "description": "Cati seviyesinde asansor makine dairesi kutusu cizilsin mi" }
      }
    },
    "elevation": {
      "type": "object",
      "description": "Bina cephe gorunusu (basitlestirilmis, semantik pencere/kat istifi)",
      "required": ["id", "label", "width", "levels"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "width": { "type": "number", "exclusiveMinimum": 0, "description": "Bu cephenin genisligi" },
        "levels": {
          "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/elevation_level" },
          "description": "Zeminden yukariya (ve varsa asagiya) dogru seviye istifi, ciziliş sirasiyla"
        },
        "axis_source": {
          "type": "string", "enum": ["vertical", "horizontal"],
          "description": "Bu cepheye plandan hangi aks ailesi izdusurulsun: 'vertical' (numerik akslar, on/arka cephe) veya 'horizontal' (alfabetik akslar, sag/sol cephe). Belirtilmezse aks cizilmez."
        }
      }
    },
    "axis": {
      "type": "object",
      "required": ["label", "position"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "position": { "type": "number" }
      }
    },
    "grid": {
      "type": "object",
      "description": "Binanin tum kat paftalarinda ortak, sabit aks izgarasi",
      "required": ["vertical_axes", "horizontal_axes"],
      "additionalProperties": false,
      "properties": {
        "vertical_axes": {
          "type": "array", "items": { "$ref": "#/definitions/axis" },
          "description": "Sabit X'te, Y boyunca uzanan duesy akslar - numerik etiketli (1,2,3,...)"
        },
        "horizontal_axes": {
          "type": "array", "items": { "$ref": "#/definitions/axis" },
          "description": "Sabit Y'de, X boyunca uzanan yatay akslar - alfabetik etiketli (A,B,C,...)"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "description": "Proje meta bilgisi",
      "required": ["units"],
      "additionalProperties": false,
      "properties": {
        "project_name": { "type": "string" },
        "units": { "type": "string", "enum": ["mm", "m"] },
        "scale": { "type": "string" },
        "project_type": {
          "type": "string",
          "enum": ["MIMARI_UYGULAMA", "MIMARI_RUHSAT_KUCUK", "STATIK_KALIP", "VAZIYET_PLANI", "DETAY"],
          "description": "TMMOB/imar mevzuati siniflandirmasi - scripts/pafta::PaperSizePlanner.classify_violation bunu meta.scale ile karsilastirip mevzuata uygunlugu raporlar. Opsiyonel; verilmezse kontrol atlanir."
        },
        "floor_width": { "type": "number", "exclusiveMinimum": 0, "description": "Tum katlarda ortak bina ayak izi genisligi (cikma yok)" },
        "floor_depth": { "type": "number", "exclusiveMinimum": 0, "description": "Tum katlarda ortak bina ayak izi derinligi" }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "color": { "type": "integer", "minimum": 0, "maximum": 255 },
          "linetype": { "type": "string" }
        }
      }
    },
    "grid": { "$ref": "#/definitions/grid" },
    "floors": {
      "type": "array",
      "description": "Soldan saga dizilecek kat plani paftalari, ciziliş sirasiyla",
      "items": { "$ref": "#/definitions/floor" }
    },
    "elevations": {
      "type": "array",
      "description": "Kat paftalarindan sonra soldan saga dizilecek cephe gorunusleri",
      "items": { "$ref": "#/definitions/elevation" }
    },
    "rev_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rev", "ts", "summary"],
        "additionalProperties": false,
        "properties": {
          "rev": { "type": "integer", "minimum": 1 },
          "ts": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
